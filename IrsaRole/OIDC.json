# don`t forget to create oidc --- create a token for service account
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::ACCOUNT:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/351B69129E8F9DED72442D58B9653B7C"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "oidc.eks.us-east-1.amazonaws.com/id/351B69129E8F9DED72442D58B9653B7C:sub": "system:serviceaccount:default:hello",
                    "oidc.eks.us-east-1.amazonaws.com/id/351B69129E8F9DED72442D58B9653B7C:aud": "sts.amazonaws.com"
                }
            }
        }
    ]
}
