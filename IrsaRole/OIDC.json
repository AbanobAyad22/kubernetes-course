# don`t forget to create oidc --- create a token for service account
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::account:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/6311C8038585E8CE322BCA2099870637"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "oidc.eks.us-east-1.amazonaws.com/id/6311C8038585E8CE322BCA2099870637:aud": "sts.amazonaws.com"
                }
            }
        }
    ]
}
